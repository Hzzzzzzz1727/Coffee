# Database settings below are used by the optional Node.js backend.
DB_AUTH=windows
DB_SERVER=localhost
DB_INSTANCE=MSSQLSERVER
DB_LOCAL_SHARED_MEMORY=false
DB_PORT=1433
DB_DATABASE=CoffeeOS
# Leave DB_USER and DB_PASSWORD blank when DB_AUTH=windows.
DB_USER=
DB_PASSWORD=
# Keep false for local SQL Server setups without a trusted TLS certificate.
# Set true for Azure SQL or another server configured with a trusted certificate.
DB_ENCRYPT=false
PORT=3031
CLIENT_ORIGIN=http://localhost:5173
# JWT_SECRET is used by the optional Node.js backend.
JWT_SECRET=replace_with_a_32_character_or_longer_random_secret
# Bản vận hành ASP.NET phục vụ Vue và API cùng origin.
VITE_API_URL=/api
# ASP.NET reads .env; leave this commented to use its generated local secret.
# COFFEE_JWT_SECRET=replace_with_a_32_character_or_longer_random_secret
# Public account registration is disabled unless this is set to true in the
# ASP.NET server's .env file or Windows Environment Variables.
# COFFEE_ALLOW_REGISTRATION=false
# SMTP cho tính năng gửi mã đặt lại mật khẩu (ASP.NET Core).
# .NET đọc các giá trị này từ .env hoặc Windows Environment Variables.
# Gmail App Password có thể dán theo định dạng chia nhóm có khoảng trắng.
COFFEE_SMTP_HOST=smtp.gmail.com
COFFEE_SMTP_PORT=587
COFFEE_SMTP_USER=
COFFEE_SMTP_PASSWORD=
COFFEE_SMTP_FROM=
